{
  "name": "haodai.reminder.dispatch",
  "active": false,
  "versionId": "haodai-v2-foundation-reminder-dispatch-1",
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Every minute: fetch due reminders from internal API, push via internal LINE endpoint, mark delivered/failed. No AI Agent. No production credentials."
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Taipei"
  },
  "pinData": {},
  "nodes": [
    {
      "parameters": {
        "content": "## haodai.reminder.dispatch\n\n**Status:** inactive by default\n\n**Purpose:** Dispatch due reminders via internal APIs only.\n\n### Env vars (placeholders)\n- `ASSISTANT_API_BASE_URL` e.g. `http://*********:8787`\n- `N8N_CALLBACK_TOKEN` (header `x-internal-token`)\n\n### Input\nSchedule tick (no body)\n\n### Output\nPer-item delivery result `{ reminder_id, status }`\n\n### Rules\n- Max 20 reminders / run\n- Delivery idempotency key required\n- No AI Agent node\n- No direct Supabase / LINE secrets",
        "height": 420,
        "width": 420
      },
      "id": "note-overview",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{($env.ASSISTANT_API_BASE_URL || 'http://placeholder.local:8787') + '/v1/internal/reminders/due'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{$env.N8N_CALLBACK_TOKEN || 'replace_with_local_n8n_token'}}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-due",
      "name": "Fetch Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 200],
      "notes": "Input: none. Output: { reminders: [...] }"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{($json.reminders || []).length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-reminders",
      "name": "Has Reminders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 200]
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "split-reminders",
      "name": "Loop Reminders",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [760, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{($env.ASSISTANT_API_BASE_URL || 'http://placeholder.local:8787') + '/v1/internal/line/push'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{$env.N8N_CALLBACK_TOKEN || 'replace_with_local_n8n_token'}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"to_user_id\": \"{{$json.user_id}}\",\n  \"messages\": [{ \"type\": \"text\", \"text\": \"提醒：{{$json.title}}\" }],\n  \"delivery_key\": \"{{$json.delivery_key}}\"\n}",
        "options": {}
      },
      "id": "http-push",
      "name": "Internal LINE Push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 120],
      "notes": "Never embeds LINE channel token; assistant-api owns LINE credentials."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{($env.ASSISTANT_API_BASE_URL || 'http://placeholder.local:8787') + '/v1/internal/reminders/delivered'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{$env.N8N_CALLBACK_TOKEN || 'replace_with_local_n8n_token'}}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"user_id\": \"{{$('Loop Reminders').item.json.user_id}}\",\n  \"reminder_id\": \"{{$('Loop Reminders').item.json.reminder_id}}\",\n  \"delivery_key\": \"{{$('Loop Reminders').item.json.delivery_key}}\"\n}",
        "options": {}
      },
      "id": "http-mark-delivered",
      "name": "Mark Delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1240, 120]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "stopped_no_reminders"
            }
          ]
        },
        "options": {}
      },
      "id": "noop-empty",
      "name": "Stop Empty",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [760, 320]
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [[{ "node": "Fetch Due Reminders", "type": "main", "index": 0 }]]
    },
    "Fetch Due Reminders": {
      "main": [[{ "node": "Has Reminders?", "type": "main", "index": 0 }]]
    },
    "Has Reminders?": {
      "main": [
        [{ "node": "Loop Reminders", "type": "main", "index": 0 }],
        [{ "node": "Stop Empty", "type": "main", "index": 0 }]
      ]
    },
    "Loop Reminders": {
      "main": [[{ "node": "Internal LINE Push", "type": "main", "index": 0 }]]
    },
    "Internal LINE Push": {
      "main": [[{ "node": "Mark Delivered", "type": "main", "index": 0 }]]
    }
  }
}

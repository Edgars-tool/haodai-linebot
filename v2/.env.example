# HaoDai v2 Foundation — placeholders only. Never put real secrets here.

# Runtime
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Taipei

# Internal API (assistant-api)
ASSISTANT_API_BASE_URL=http://127.0.0.1:8787
ASSISTANT_API_INTERNAL_TOKEN=replace_with_local_dev_token

# LINE (interfaces only — do not fill production values in git)
LINE_CHANNEL_SECRET=replace_with_local_dev_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_with_local_dev_token
LINE_WEBHOOK_SIGNATURE_REQUIRED=false

# Supabase (local/dev placeholders — never production)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace_with_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

# OpenClaw — sole primary agent
OPENCLAW_BASE_URL=http://127.0.0.1:9001
OPENCLAW_API_TOKEN=replace_with_local_openclaw_token

# Hermes — internal research worker only (MUST NOT receive LINE events)
HERMES_BASE_URL=http://127.0.0.1:9002
HERMES_API_TOKEN=replace_with_local_hermes_token
HERMES_ALLOW_LINE_EVENTS=false

# n8n internal callbacks (workflows stay inactive by default)
N8N_INTERNAL_BASE_URL=http://127.0.0.1:8787
N8N_CALLBACK_TOKEN=replace_with_local_n8n_token
